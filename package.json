{
  "name": "@agentic-income/engine",
  "version": "0.1.0",
  "description": "Shared engine for the Agentic Income Network: canonical catalog, affiliate helpers, audit, and L99 brain/skills. One source of truth for honest recurring-payer routing across hub + spokes + redirector.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "audit": "node scripts/affiliate-audit.mjs",
    "revenue": "node scripts/revenue-report.mjs",
    "catalog:publish": "node scripts/publish-catalog.mjs",
    "test": "node --test tests/*.mjs",
    "lint": "echo 'add eslint if needed'"
  },
  "files": [
    "dist",
    "data",
    "scripts",
    "skills",
    "catalog.js",
    "catalog.d.ts",
    "affiliate.js",
    "affiliate.d.ts",
    "audit.js",
    "audit.d.ts",
    "l99.js",
    "l99.d.ts",
    "react.js",
    "react.d.ts",
    "catalog-helpers.js",
    "catalog-helpers.d.ts",
    "analytics.js",
    "analytics.d.ts"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "affiliate",
    "income",
    "catalog",
    "agentic",
    "l99",
    "acos"
  ],
  "author": "FrankX / Starlight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/affiliate-agent-skills"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
